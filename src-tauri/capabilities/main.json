{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "仅允许主窗口访问运行状态与工作区资产任务。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-runtime-info",
    "allow-model-snapshot",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-clear-model",
    "allow-open-model-license",
    "allow-preferences-snapshot",
    "allow-update-preferences",
    "allow-recovery-status",
    "allow-set-session-recovery",
    "allow-clear-session-data",
    "allow-open-settings",
    "allow-workspace-snapshot",
    "allow-create-batch",
    "allow-create-batch-from-folder",
    "allow-append-batch-folder",
    "allow-create-batch-from-zip",
    "allow-append-batch",
    "allow-append-batch-zip",
    "allow-export-batch-zip",
    "allow-batch-items",
    "allow-review-batch-item",
    "allow-batch-result-preview-url",
    "allow-set-batch-paused",
    "allow-cancel-batch",
    "allow-retry-batch-item",
    "allow-retry-failed-batch",
    "allow-remove-batch",
    "allow-import-asset",
    "allow-paste-asset",
    "allow-select-asset",
    "allow-cancel-task",
    "allow-retry-preview",
    "allow-release-preview",
    "allow-remove-asset",
    "allow-auto-cutout",
    "allow-switch-workflow",
    "allow-select-points",
    "allow-refine-mask",
    "allow-set-background",
    "allow-paint-mask",
    "allow-step-history",
    "allow-export-png",
    "allow-preview-url",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-shell-snapshot",
    "allow-shell-cancel",
    "allow-shell-retry",
    "allow-shell-open-result",
    "allow-shell-open-workbench",
    "allow-configure-context-menu",
    "allow-open-utility-window",
    "allow-set-menu-language",
    "allow-set-shortcut-recording"
  ]
}
