{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "resources",
  "description": "辅助窗口使用独立权限，不访问图片工作区。",
  "windows": [
    "resources"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-preferences-snapshot",
    "allow-open-utility-window",
    "allow-set-menu-language",
    "allow-model-snapshot",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-clear-model",
    "allow-open-model-license"
  ]
}
